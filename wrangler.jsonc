{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veil-proxy",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/proxy"]
  },
  "observability": {
    "enabled": true
  }
}
